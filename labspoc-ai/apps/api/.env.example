# ==============================================================================
# LabSPOC AI — Environment Configuration (Development)
# ==============================================================================

# Core Application Settings
APP_NAME="LabSPOC AI API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Institutional Profile
LAB_NAME="AI & ML Laboratory"
INSTITUTION_NAME="Oriental Institute of Science & Technology, Bhopal"

# Database Connection (SQLite for local dev)
DATABASE_URL=sqlite:///./labspoc.db

# Storage & Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
STORAGE_BACKEND=local
# For S3-compatible storage (e.g. MinIO, Cloudflare R2, AWS S3):
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=labspoc-uploads
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_REGION=us-east-1
# S3_PUBLIC_URL=https://cdn.example.com

# Network & Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120
JWT_SECRET=dev-secret-key-must-be-at-least-32-chars-long-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-admin-password
ACCESS_TOKEN_MINUTES=120

# Google Gemini AI Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Retrieval Tuning
SEMANTIC_RETRIEVAL_ENABLED=true
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.18

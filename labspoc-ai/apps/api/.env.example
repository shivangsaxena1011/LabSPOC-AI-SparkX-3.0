APP_NAME=LabSPOC AI API
DATABASE_URL=sqlite:///./labspoc.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:3000
MIN_RETRIEVAL_SCORE=1
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash
ADMIN_API_KEY=replace-with-a-long-random-secret
LAB_NAME=AI & ML Laboratory
INSTITUTION_NAME=Oriental Institute of Science & Technology, Bhopal
# Phase 05: set a unique 32+ character JWT secret and bootstrap admin credentials.
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password-12-chars-minimum
ACCESS_TOKEN_MINUTES=60
# Phase 06: Gemini embedding model for hybrid semantic + lexical retrieval.
EMBEDDING_MODEL=gemini-embedding-001
SEMANTIC_RETRIEVAL_ENABLED=true
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.18

# ==============================================================================
# LabSPOC AI — Environment Configuration (Production Deployment)
# ==============================================================================

# Core Application Settings
APP_NAME="LabSPOC AI API"
ENVIRONMENT=production
LOG_LEVEL=INFO

# Institutional Profile
LAB_NAME="AI & ML Laboratory"
INSTITUTION_NAME="Oriental Institute of Science & Technology, Bhopal"

# Database Connection (PostgreSQL on Neon / Supabase / Managed Server)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://labspoc_user:STRONG_PRODUCTION_PASSWORD@ep-sample.ap-south-1.aws.neon.tech/labspoc?sslmode=require

# Storage & Upload Configuration (Persistent Cloudflare R2 / AWS S3)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=labspoc-production-uploads
S3_ACCESS_KEY_ID=PROD_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=PROD_S3_SECRET_ACCESS_KEY
S3_REGION=auto
S3_PUBLIC_URL=https://cdn.labspoc.oist.edu
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_MB=25

# Network, CORS & Security Boundaries
# Specify exact production domain(s) of the Vercel frontend:
CORS_ORIGINS=https://labspoc-ai.vercel.app,https://labspoc.oist.edu
RATE_LIMIT_PER_MINUTE=120

# Cryptographic Keys (MUST BE A 32+ CHARACTER CRYPTOGRAPHICALLY SECURE KEY)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_A_UNIQUE_64_HEX_CHAR_SECRET_KEY_NEVER_USE_DEFAULT
ADMIN_USERNAME=oist_lab_admin
ADMIN_PASSWORD=GENERATE_A_STRONG_RANDOM_ADMIN_PASSWORD_MIN_16_CHARS
ACCESS_TOKEN_MINUTES=120

# Google Gemini API Key (From Google AI Studio)
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_YOUR_SECURE_PRODUCTION_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Retrieval Tuning
SEMANTIC_RETRIEVAL_ENABLED=true
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.18
